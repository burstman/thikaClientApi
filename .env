# .env

# Fabric MSP ID
FABRIC_MSP_ID=Org1MSP

# Path to the crypto material, relative to the API server's location
FABRIC_CRYPTO_PATH=../test-network/organizations/peerOrganizations/org1.example.com

# Identity to use for submitting transactions
FABRIC_CERT_PATH=./wallet/appUser1/msp/signcerts/cert.pem
FABRIC_KEY_PATH=./wallet/appUser1/msp/keystore/priv_sk

# Peer connection details
FABRIC_TLS_CERT_PATH=${FABRIC_CRYPTO_PATH}/peers/peer0.org1.example.com/tls/ca.crt
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_GATEWAY_PEER=peer0.org1.example.com

# Channel and Chaincode details
FABRIC_CHANNEL_NAME=mychannel
FABRIC_CHAINCODE_NAME=thika
